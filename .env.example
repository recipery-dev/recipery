# Options: local | s3 (s3 also works for S3-compatible stores like MinIO,
# Cloudflare R2, Backblaze B2 — set S3_ENDPOINT accordingly)
STORAGE_DRIVER=local
S3_ENDPOINT=http://localhost:9000
S3_BUCKET=recipery
S3_ACCESS_KEY=recipery
S3_SECRET_KEY=recipery123
# Only needed for real AWS S3 — must match the bucket's actual region
# (e.g. eu-central-1). Leave unset for MinIO/R2, which use "auto".
S3_REGION=
# Optional — scopes all of Recipery's data under this directory in the
# bucket, so you can point it at a bucket you already share with other
# apps (e.g. S3_PREFIX=recipery) instead of writing to the bucket root.
S3_PREFIX=
LOCAL_STORAGE_PATH=./.data

# Sent as part of the User-Agent when importing a recipe from a URL — set
# this to your email or a contact URL so sites hosting a lot of your
# imports have a way to reach you if something looks off.
RECIPERY_CONTACT=
